<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>KubePS Node AllocatedResource</Name>
      <ViewSelectedBy>
        <TypeName>KubePS.NodeAllocatedResource</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <AutoSize />
        <TableHeaders>
          <TableColumnHeader><Label>Node</Label></TableColumnHeader>
          <TableColumnHeader><Label>CpuRequests</Label></TableColumnHeader>
          <TableColumnHeader><Label>CpuLimits</Label></TableColumnHeader>
          <TableColumnHeader><Label>MemoryRequests</Label></TableColumnHeader>
          <TableColumnHeader><Label>MemoryLimits</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Node</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>If ($_.cpuRequests) { "$($_.cpuRequests)m ($($_.cpuRequestsPercent)%)" }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>If ($_.cpuLimits) { "$($_.cpuLimits)m ($($_.cpuLimitsPercent)%)" }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>If ($_.memoryRequests) { "$($_.memoryRequests)Mi ($($_.memoryRequestsPercent)%)" }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>If ($_.memoryLimits) { "$($_.memoryLimits)Mi ($($_.MemoryLimitsPercent)%)" }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>